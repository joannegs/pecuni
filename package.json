{
  "name": "pecuni",
  "private": true,
  "description": "Repo-wide tooling only (git hooks, commit linting). The actual apps live in backend/ and frontend/.",
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^21.2.2",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0"
  },
  "lint-staged": {
    "frontend/**/*.{ts,html,scss,css,json}": ["prettier --write"],
